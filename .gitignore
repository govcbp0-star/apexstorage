# Workspace-level artifacts — the application lives in apexstorage/
# (its own .gitignore covers app-local files like .next/, .env*, node_modules/)
node_modules/
.freebuff/
.next/
.env*
.DS_Store
*.log

# Secrets — never commit, wherever they land
*.pem
*-firebase-adminsdk-*.json
firebase-service-account*.json
service-account*.json
