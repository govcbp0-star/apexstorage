{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "vaultRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$requestId": {
        ".write": "auth != null"
      }
    },
    "contactMessages": {
      ".read": true,
      ".write": true,
      "$messageId": {
        ".write": "auth != null"
      }
    },
    "assets": {
      "$assetId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": false
      }
    },
    "orders": {
      "$orderId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": false
      }
    },
    "shipments": {
      "$shipmentId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": false
      }
    },
    "newsletter": {
      ".read": "auth != null",
      ".write": true,
      "$subId": {
        ".write": "auth != null"
      }
    },
    "transactions": {
      "$transactionId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": false
      }
    }
  }
}
